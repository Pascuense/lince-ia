{
  "id": "/",
  "name": "LINCE IA — Aprende IA Jugando",
  "short_name": "LINCE IA",
  "description": "Aprende IA Jugando — Plataforma gamificada de formación en inteligencia artificial para todas las edades. Avatares adaptativos, gamificación avanzada y lecciones personalizadas.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "tabbed", "window-controls-overlay"],
  "background_color": "#030a04",
  "theme_color": "#00E5FF",
  "orientation": "any",
  "dir": "ltr",
  "lang": "es",
  "categories": ["education", "games", "entertainment"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.lince.ia",
      "id": "app.lince.ia"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "scope_extensions": [
    {
      "origin": "https://*.lince.app"
    }
  ],
  "edge_side_panel": {
