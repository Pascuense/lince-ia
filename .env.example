# ═══════════════════════════════════════════════════════════════
# LINCE — Variables de Entorno para Azure App Service
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y rellena los valores reales.
# En Azure App Service, configura estas variables en:
#   Portal > lince-app > Settings > Environment variables
# ═══════════════════════════════════════════════════════════════

# ─── Base de Datos MySQL (Azure Database for MySQL) ───
DATABASE_URL=mysql://lince_admin:TU_PASSWORD@lince-db-acnb.mysql.database.azure.com:3306/lince_db?ssl={rejectUnauthorized:true}

# ─── Autenticación JWT ───
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_ALEATORIO_DE_64_CHARS

# ─── Azure OpenAI Service ───
AZURE_OPENAI_ENDPOINT=https://TU_RECURSO.openai.azure.com
AZURE_OPENAI_KEY=TU_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── Azure Blob Storage ───
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=TU_CUENTA;AccountKey=TU_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=lince-uploads

# ─── Push Notifications (VAPID) ───
VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY
VAPID_CONTACT_EMAIL=tu-email@tu-dominio.com

# ─── Servidor ───
NODE_ENV=production
PORT=8080

# ─── Frontend (variables VITE_ se inyectan en el build del cliente) ───
VITE_APP_TITLE=LINCE - Aprende IA Jugando
VITE_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
