# ═══════════════════════════════════════════════════════════════
# LINCE — Variables de Entorno para Azure App Service
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y rellena los valores reales.
# En Azure App Service, configura estas variables en:
#   Portal > lince-app > Settings > Environment variables
# ═══════════════════════════════════════════════════════════════

# ─── Base de Datos MySQL (Azure Database for MySQL) ───
DATABASE_URL="mysql://lince_admin:TU_PASSWORD_AQUI@lince-db-acnb.mysql.database.azure.com:3306/lince_db?ssl={"rejectUnauthorized":true}"

# ─── Autenticación JWT ───
JWT_SECRET="7adf4ebe6dde1a1335715620f70215bb456386dcae09d8944cba08c8182732a9e0495022afbad931bb142a7fb2f02c565993302b6d84085140ba7f32cce3852b"

# ─── Azure OpenAI Service ───
AZURE_OPENAI_ENDPOINT="https://TU_RECURSO.openai.azure.com"
AZURE_OPENAI_KEY="TU_AZURE_OPENAI_KEY"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# ─── Azure Blob Storage ───
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=TU_CUENTA;AccountKey=TU_KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER="lince-uploads"

# ─── Push Notifications (VAPID) ───
VAPID_PUBLIC_KEY="BP3MKWcRIMkmyV5Y91BRwYSZJIJdsfqtWos3PDc_iL5MupRvUBGuG4pJjSSZuWB3yUHFK8KU9kB8PDukw_qiaRc"
VAPID_PRIVATE_KEY="OtJn81tB31F2WVr49pHmx5AET72we3IXI5j97tSaOSM"
VAPID_CONTACT_EMAIL="cristobal@acnb.es"

# ─── Servidor ───
NODE_ENV="production"
PORT=8080

# ─── Frontend (variables VITE_ se inyectan en el build del cliente) ───
VITE_APP_TITLE="LINCE - Aprende IA Jugando"
VITE_VAPID_PUBLIC_KEY="BP3MKWcRIMkmyV5Y91BRwYSZJIJdsfqtWos3PDc_iL5MupRvUBGuG4pJjSSZuWB3yUHFK8KU9kB8PDukw_qiaRc"
