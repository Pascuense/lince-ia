# ═══════════════════════════════════════════════════════════════
# LINCE — Variables de Entorno para Desarrollo
# ═══════════════════════════════════════════════════════════════
# Este archivo configura el entorno de desarrollo local.
# No incluye secretos reales — copia .env.example como .env
# y rellena los valores de producción allí.
# ═══════════════════════════════════════════════════════════════

# Vite HMR Configuration
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173
VITE_DEV_HMR_PROTOCOL=http
VITE_DEV_HMR_HOST=localhost
VITE_DEV_HMR_PORT=5173

# Memory & Performance
NODE_OPTIONS=--max-old-space-size=4096
NODE_ENV=development

# Debugging (descomenta para ver logs internos de Vite al diagnosticar problemas)
# DEBUG=vite:*

# LINCE Configuration
VITE_APP_ID=lince-dev
VITE_APP_TITLE=LINCE IA (Development)
